{
  "name": "ownfolio",
  "private": true,
  "scripts": {
    "build": "cross-env NODE_ENV=production node build.js",
    "lint:fix": "npm run prettier -- --write --log-level warn; npm run eslint -- --fix --quiet",
    "lint": "tsc --noEmit && npm run prettier -- --check && npm run eslint",
    "lint:commit": "commitlint",
    "eslint": "eslint . --quiet",
    "pages": "cross-env NODE_ENV=pages node ./pages/build.js",
    "prettier": "prettier './**/*.{html,css,md,js,mjs,ts,mts,tsx,json,yml,yaml}'",
    "screenshots": "npm run build && cross-env NODE_ENV=screnshots PGHOST=localhost PGDATABASE=ownfolio PGUSER=ownfolio PGPASSWORD=ownfolio ts-node test/screenshots.ts",
    "start": "node build.js && cross-env PGHOST=localhost PGDATABASE=ownfolio PGUSER=ownfolio PGPASSWORD=ownfolio node --enable-source-maps dist/index.js",
    "start:dev": "nodemon --watch ./src --ext html,css,ts,tsx server",
    "test": "vitest",
    "test:bench": "vitest bench",
    "verify": "npm run lint:commit -- --from HEAD~1 --to HEAD && npm run lint:fix && npm run lint && npm test -- --run"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@ownfolio/rpc-browser": "0.3.0",
    "@ownfolio/rpc-core": "0.3.0",
    "@ownfolio/rpc-express": "0.3.0",
    "@ownfolio/rpc-openapi": "0.3.0",
    "@tanstack/react-query": "5.104.5",
    "@types/body-parser": "1.19.6",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/d3-color": "3.1.3",
    "@types/d3-scale": "4.0.9",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axios": "1.20.0",
    "bignumber.js": "11.1.5",
    "body-parser": "2.4.0",
    "clsx": "2.1.1",
    "commander": "15.0.0",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "d3-color": "3.1.0",
    "d3-scale": "4.0.2",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "id128": "1.6.6",
    "jsep": "1.6.0",
    "normalize.css": "8.0.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-router-dom": "7.18.4",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@linaria/core": "7.0.0",
    "@linaria/react": "7.0.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/markdown-it": "14.2.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "@wyw-in-js/esbuild": "^1.1.0",
    "autoprefixer": "10.6.1",
    "conventional-changelog": "7.2.1",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "jsdom": "29.1.1",
    "markdown-it": "14.3.3",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "puppeteer": "25.16.0",
    "sharp": "0.35.5",
    "testcontainers": "12.2.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
